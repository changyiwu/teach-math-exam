      "type": "triangle_center",
      "config": {
        "center_type": "circumcenter",
        "triangle": {"vertices": {"A": [0,2], "B": [6,2], "C": [1,0]}}
      }
    },
    {
      "id": "custom_incenter",
      "title": "自訂三角形內心",
