      "config": {
        "center_type": "centroid",
        "triangle": {"vertices": {"A": [0,3], "B": [6,3], "C": [1.2,0]}}
      }
    },
    {
      "id": "custom_circumcenter",
      "title": "自訂鈍角三角形外心",
