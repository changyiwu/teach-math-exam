      "config": {
        "points": {"A": 18, "B": 25, "C": 33, "D": 150, "E": 250},
        "radius_lines": ["A", "D"], "central_angle": ["A", "D"],
        "inscribed_angle": {"vertex": "E", "arc": ["A", "D"]}
      }
    },
    {
      "id": "custom_centroid",
      "title": "自訂三角形重心",
      "note": "重心與三條中線使用本體的實際頂點",
