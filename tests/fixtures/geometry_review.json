      "config": {
        "subtype": "right", "vertices": {"A": [4,3], "B": [0,0], "C": [0,3]},
        "right_angle_at": "C", "angle_arcs": {"A": 1, "B": 2},
        "side_labels": {"AB": "5", "BC": "3", "CA": "4"}
      }
    },
    {
      "id": "isosceles",
      "title": "等腰三角形",
      "note": "等邊刻度與底角一致，長標籤自動留白",
      "type": "triangle",
      "config": {
        "subtype": "isosceles", "equal_marks": {"AC": 1, "BC": 1},
        "angle_arcs": {"A": 1, "B": 1},
        "side_labels": {"AB": "10 cm", "AC": "13 cm", "BC": "13 cm"}
      }
    },
    {
      "id": "right_trapezoid",
      "title": "直角梯形",
      "note": "AB 與 DC 平行，直角位於 A 與 D",
